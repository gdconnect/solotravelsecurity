{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solotravelsecurity.com/schemas/searchable-item.schema.json",
  "title": "SearchableItem",
  "description": "Formal JSON Schema for atomic solo travel security LEGO blocks indexed for faceted search.",
  "type": "object",
  "required": [
    "id",
    "title",
    "slug",
    "url",
    "type",
    "category",
    "categoryLabel",
    "description",
    "archetypes",
    "riskTiers",
    "format",
    "priceTier"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier (e.g. SKU, scam ID, or hub code)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Display name of the gear item, threat dossier, or airport guide"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "description": "URL-safe unique slug"
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "description": "Internal playbook route or external verified link"
    },
    "type": {
      "type": "string",
      "enum": ["product", "scam", "airport", "topic", "regulatory"],
      "description": "Primary entity classification"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "Taxonomy category slug (e.g. perimeter_defense, transit_security)"
    },
    "categoryLabel": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable taxonomy category label"
    },
    "pillarId": {
      "type": "string",
      "description": "Optional sovereign security pillar ID (e.g. PIL-PERIMETER)"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Operational description or situational rationale"
    },
    "tagline": {
      "type": "string",
      "description": "Tactical summary or opening hook phrase"
    },
    "archetypes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Target traveler archetypes"
    },
    "riskTiers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["Low", "Moderate", "Elevated", "High", "Critical"]
      },
      "minItems": 1
    },
    "destinations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Associated city slugs or destination identifiers"
    },
    "format": {
      "type": "string",
      "enum": ["physical_gear", "digital_tool", "truth_table", "field_protocol", "customs_rule"]
    },
    "priceTier": {
      "type": "string",
      "enum": ["free", "under_25", "25_to_50", "50_plus"]
    },
    "priceFormatted": {
      "type": "string",
      "description": "Formatted price string e.g. '$14.99'"
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "ratingCount": {
      "type": "integer",
      "minimum": 0
    },
    "affiliateUrl": {
      "type": "string",
      "format": "uri"
    },
    "pros": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "keyHighlight": {
      "type": "string",
      "description": "Key distinguishing feature or curfew alert"
    }
  },
  "additionalProperties": false
}

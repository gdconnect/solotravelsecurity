{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solotravelsecurity.com/schemas/airport-ingress-hub.schema.json",
  "title": "AirportSecurityHub",
  "description": "Formal JSON Schema for airport ingress hubs, late night transit curfews, and official taxi protocols.",
  "type": "object",
  "required": [
    "iata",
    "name",
    "citySlug",
    "countryCode",
    "lateNightCurfew",
    "officialTaxiDesk",
    "rideHailingPickupZone",
    "emergencyConnectivity"
  ],
  "properties": {
    "iata": { "type": "string", "minLength": 3, "maxLength": 3 },
    "name": { "type": "string", "minLength": 1 },
    "citySlug": { "type": "string", "minLength": 1 },
    "countryCode": { "type": "string", "minLength": 2, "maxLength": 2 },
    "lateNightCurfew": {
      "type": "object",
      "required": [
        "lastTrainDepartureLocal",
        "lastBusDepartureLocal",
        "curfewVulnerabilityHour",
        "strandedVulnerabilityRisk"
      ],
      "properties": {
        "lastTrainDepartureLocal": { "type": "string" },
        "lastBusDepartureLocal": { "type": "string" },
        "curfewVulnerabilityHour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "strandedVulnerabilityRisk": { "type": "string" }
      }
    },
    "officialTaxiDesk": {
      "type": "object",
      "required": [
        "locationDescription",
        "flatRateToCityCenterEurOrUsd",
        "rateType",
        "scamWarning"
      ],
      "properties": {
        "locationDescription": { "type": "string" },
        "flatRateToCityCenterEurOrUsd": { "type": "number", "minimum": 0 },
        "rateType": { "type": "string", "enum": ["flat_rate", "metered"] },
        "scamWarning": { "type": "string" }
      }
    },
    "rideHailingPickupZone": {
      "type": "object",
      "required": ["allowedApps", "designatedPickupFloorOrPillar", "waitingSafetyRating"],
      "properties": {
        "allowedApps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "designatedPickupFloorOrPillar": { "type": "string" },
        "waitingSafetyRating": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "emergencyConnectivity": {
      "type": "object",
      "required": [
        "publicWifiSsid",
        "simCardBoothsLocationAirside",
        "simCardBoothsLocationLandside"
      ],
      "properties": {
        "publicWifiSsid": { "type": "string" },
        "simCardBoothsLocationAirside": { "type": "string" },
        "simCardBoothsLocationLandside": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}

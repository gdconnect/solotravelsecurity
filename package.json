{
  "name": "solotravelsecurity",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3020",
    "start": "npx serve out -p 3020",
    "lint": "eslint",
    "lint:ox": "oxlint",
    "lint:ox:quiet": "oxlint --quiet",
    "format:ox": "oxfmt --write",
    "format:check": "oxfmt --check",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "test:graphql": "tsx scripts/test-graphql-transport.mjs",
    "test:harvest": "tsx scripts/harvest-gemini-grounded-data.mjs",
    "test:gemini": "tsx scripts/test-gemini-schema-pipeline.ts",
    "codegen": "graphql-codegen --config codegen.ts && node scripts/graphql-codegen-postprocess.mjs && node scripts/graphql-emit-documents.mjs",
    "sync:graphql-schema": "node scripts/graphql-sync-schema.mjs",
    "check:graphql-schema": "node scripts/graphql-sync-schema.mjs --check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@xstate/react": "^6.1.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xstate": "^5.32.6",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "graphql": "^16.14.2",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "^4.129.0"
  }
}

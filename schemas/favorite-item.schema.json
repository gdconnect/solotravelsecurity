{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solotravelsecurity.com/schemas/favorite-item.schema.json",
  "title": "FavoriteItem",
  "description": "Formal JSON Schema for local-first, zero-PII saved favorites and custom travel security kit items.",
  "type": "object",
  "required": ["id", "type", "title", "url", "category", "description", "savedAt"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier of the favorited item"
    },
    "type": {
      "type": "string",
      "enum": ["product", "scam", "airport", "topic", "checklist", "regulatory"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Display name of the saved item"
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "description": "Destination link or affiliate URL"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "Taxonomy category or pillar name"
    },
    "description": {
      "type": "string",
      "description": "Item description or rationale"
    },
    "price": {
      "type": "string",
      "description": "Formatted price string e.g. '$24.99'"
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "badge": {
      "type": "string",
      "description": "Optional highlight badge or protocol note"
    },
    "savedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when item was favorited"
    },
    "notes": {
      "type": "string",
      "maxLength": 500,
      "description": "Zero-PII private traveler note"
    }
  },
  "additionalProperties": false
}
